static func count() -> int:
	return LIST.size()


static func get_by_id(pic_id: String) -> Dictionary:
	for d in LIST:
		if d.id == pic_id:
			return d
	return {}


static func build(pic_id: String) -> Nonogram:
	var d := get_by_id(pic_id)
	if d.is_empty():
		return null
	var p := Nonogram.from_strings(d.rows, "pic-" + pic_id)
	p.title_key = "pic_" + pic_id
	return p
