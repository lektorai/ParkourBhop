# Настройки сборки для RuStore. Скопируйте файл в .env и заполните. Файл .env в git не попадает.

# Рекламные блоки Yandex Mobile Ads (кабинет Рекламной сети Яндекса → приложение → блоки).
# Пусто — используются демо-блоки Яндекса. В отладочной сборке демо-блоки используются всегда.
YANDEX_ADS_INTERSTITIAL_ID=
YANDEX_ADS_REWARDED_ID=

# Покупки в RuStore. Включайте, только когда в RuStore Консоли подключена монетизация
# (с 1 февраля 2026 года для платежей нужен статус ИП или юрлица) и заведены товары.
PAYMENTS_ENABLED=false

# Идентификатор приложения из RuStore Консоли: число из адреса console.rustore.ru/apps/<число>.
# Нужен только при PAYMENTS_ENABLED=true.
RUSTORE_CONSOLE_APP_ID=
