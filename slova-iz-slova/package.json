{
  "name": "slova-iz-slova",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:yandex": "cross-env PLATFORM=yandex vite build && sdk-dev-proxy -p dist/yandex --dev-mode=true",
    "levels": "tsx scripts/generate-levels.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "build": "cross-env PLATFORM=local vite build",
    "build:yandex": "tsx scripts/build-yandex.ts",
    "build:rustore:web": "cross-env PLATFORM=rustore vite build",
    "build:rustore": "tsx scripts/build-rustore.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.0.0",
    "@fontsource-variable/nunito": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "@yandex-games/sdk-dev-proxy": "*",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
